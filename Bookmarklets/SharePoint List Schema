javascript:(async()=>{if(typeof _spPageContextInfo==="undefined"||!_spPageContextInfo.listTitle||!_spPageContextInfo.listId){alert("Please run this on a SharePoint List or Library page.");return;}const listId=_spPageContextInfo.listId.replace(/[{}]/g,"");const r=await fetch(`${_spPageContextInfo.webAbsoluteUrl}/_api/web/lists/getbytitle('${_spPageContextInfo.listTitle}')/fields?$filter=Hidden eq false and ReadOnlyField eq false`,{headers:{Accept:"application/json; odata=verbose"}});const d=await r.json();const s={listName:_spPageContextInfo.listTitle,listId:listId,extractDate:new Date().toISOString(),columns:d.d.results.map(f=>({name:f.Title,internal:f.InternalName,type:f.TypeAsString,required:f.Required}))};const j=JSON.stringify(s,null,2);console.log(j);await navigator.clipboard.writeText(j);alert("JSON Schema copied to clipboard!");})();
