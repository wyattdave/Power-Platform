/* Power Bookmarklets: Open in Power Automate
   Opens a Power Apps cloud flow or flow list in the equivalent Power Automate page.
   Supports regular and Default-<guid> environment IDs.
   Copy paste bottom url-enocded version into bookmark, top version is for reference only.
   Standard bookmarklet compatible: yes */
(() => {
  const sGuid = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';
  const oRoute = new RegExp(
    '^https://make\\.powerapps\\.com/environments/((?:default-)?' + sGuid + ')' +
    '/(?:solutions/' + sGuid + '/objects/cloudflows/(' + sGuid + ')(?:/(?:view|edit))?|logicflows)' +
    '/?(?:[?#].*)?$',
    'i'
  );
  const aMatch = location.href.match(oRoute);

  if (!aMatch) {
    alert('Open this bookmarklet from a Power Apps cloud flow or cloud flows page.');
    return;
  }

  const sTarget = 'https://make.powerautomate.com/environments/' + aMatch[1] +
    '/flows' + (aMatch[2] ? '/' + aMatch[2] : '');
  location.assign(sTarget);
})();

