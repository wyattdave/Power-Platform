/* Power Bookmarklets: Excel Drive Info
   On a Excel workbook clicking the Bookmarklet adds the files drive information, ideal for setting Power Automate environment variables.
   Copy paste bottom url-enocded version into bookmark, top version is for reference only.
   Standard bookmarklet compatible: yes */

javascript:(async () => {
    try {
        const html = document.documentElement.innerHTML;

        const find = regex => (html.match(regex) || [])[1] || "";

        const driveId = find(
            /driveId["']?\s*[:=]\s*["%27]([^"%27]+)["%27]/i
        );

        const fileId = find(
            /(?:fileId|itemId)["%27]?\s*[:=]\s*["%27]([^"%27]+)["%27]/i
        );

        const text = `${driveId}\n${fileId}`;

        try {
            await navigator.clipboard.writeText(text);

            alert(
                "Drive ID:\n" +
                driveId +
                "\n\nFile ID:\n" +
                fileId +
                "\n\nCopied to clipboard."
            );
        } catch {
            prompt("Copy:", text);
        }
    } catch (e) {
        alert(e.message);
    }
})();

